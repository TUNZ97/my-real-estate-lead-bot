# ============================================================
# Real Estate Lead Bot — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# Application
APP_ENV=development
APP_NAME=real-estate-lead-bot
DEBUG=true
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (MySQL — local development)
# Create a database first: CREATE DATABASE leadbot CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/leadbot
DATABASE_URL_SYNC=mysql+pymysql://root:password@localhost:3306/leadbot

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret

# AI Provider (optional for MVP — rule-based extraction works without this)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# n8n (install via npm: npm install -g n8n)
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
